# VibeX19 environment template — copy to .env and fill in real values.
# NEVER commit .env or real credentials to Git.

# ── Supabase (persistent database) ─────────────────────────────
# Project URL
SUPABASE_URL=
# Publishable (anon) key — safe for exposure where the design requires it
SUPABASE_PUBLISHABLE_KEY=
# Direct PostgreSQL connection string (server-side ONLY, contains the password)
SUPABASE_DATABASE_URL=

# ── Website (Flask) ────────────────────────────────────────────
# Long random string used to salt passwords and 2FA secrets.
# Generate once, never change afterwards.
FLASK_SESSION_KEY=

# ── Ports (localhost-first development) ────────────────────────
WEBSITE_PORT=3006
GAMESERVER_COMM_PORT=3000
REDIS_PORT=6379
